# Copy to .env and fill in your values

# External PostgreSQL connection
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=restart
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT signing key (base64-encoded 256-bit key)
JWT_SECRET=change-me-to-a-base64-encoded-256-bit-key

# Initial admin account seeded on first boot
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Optional
RESTART_API_BASE_URL=http://server:8080
SERVER_PORT=8080
WEB_PORT=3000
JAVA_OPTS=
